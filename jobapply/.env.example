# ==========================================
# JobApply Configuration (.env.example)
# ==========================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ------------------------------------------
# BACKEND CONFIGURATION (Node.js)
# ------------------------------------------
PORT=3001
NODE_ENV=development

# CORS Settings (Frontend URL)
FRONTEND_URL=http://localhost:5173

# Database/Storage Path (Absolute path for application data)
DATA_PATH=./data

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# ------------------------------------------
# GEMINI AI CONFIGURATION
# ------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------
# BOT CONFIGURATION (Python/Selenium)
# ------------------------------------------

# Browser Settings
BROWSER_TYPE=chrome
HEADLESS_MODE=false
BROWSER_LANGUAGE=en-US

# Delay Settings (in seconds) - Prevents bot detection
MIN_DELAY=2
MAX_DELAY=5
ACTION_DELAY=1

# Screenshot Settings (for debugging)
TAKE_SCREENSHOTS=true
SCREENSHOT_PATH=./screenshots

# ------------------------------------------
# JOB PORTAL CREDENTIALS
# ------------------------------------------
# Add your credentials for each platform you want to use
# Leave empty if not using that platform

# Naukri.com
NAUKRI_EMAIL=your_naukri_email@example.com
NAUKRI_PASSWORD=your_naukri_password
NAUKRI_ENABLED=true

# LinkedIn
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password
LINKEDIN_ENABLED=false

# Indeed
INDEED_EMAIL=your_indeed_email@example.com
INDEED_PASSWORD=your_indeed_password
INDEED_ENABLED=false

# Glassdoor
GLASSDOOR_EMAIL=your_glassdoor_email@example.com
GLASSDOOR_PASSWORD=your_glassdoor_password
GLASSDOOR_ENABLED=false

# Foundit
FOUNDIT_EMAIL=your_foundit_email@example.com
FOUNDIT_PASSWORD=your_foundit_password
FOUNDIT_ENABLED=false

# ------------------------------------------
# APPLICATION PREFERENCES
# ------------------------------------------

# Job Search Keywords
JOB_KEYWORDS=software engineer,developer,programmer

# Locations
JOB_LOCATIONS=Bangalore,Mumbai,Delhi,Pune,Hyderabad

# Experience Level (fresher, mid, senior)
EXPERIENCE_LEVEL=fresher,mid

# Job Type (full-time, part-time, contract, internship)
JOB_TYPE=full-time

# Remote Preference (true/false)
REMOTE_ONLY=false

# Salary Range (minimum expected CTC in Lakhs)
MIN_CTC=5

# ------------------------------------------
# RESUME & PROFILE
# ------------------------------------------

# Absolute path to your resume (PDF format recommended)
RESUME_PATH=./resumes/my_resume.pdf

# Profile Summary for AI generation
PROFILE_SUMMARY=Experienced software developer with expertise in Python, JavaScript, and React.

# Skills (comma-separated)
SKILLS=Python,JavaScript,React,Node.js,SQL,MongoDB,Docker,AWS

# Education Details
EDUCATION=B.Tech in Computer Science

# ------------------------------------------
# ADVANCED SETTINGS
# ------------------------------------------

# Maximum applications per day (0 for unlimited)
MAX_APPLICATIONS_PER_DAY=50

# Skip jobs requiring specific skills (comma-separated)
SKIP_SKILLS=php,sales,marketing

# Auto-apply to Easy Apply jobs only (false = apply to company websites too)
AUTO_APPLY_EXTERNAL=true

# Timeout for page loads (seconds)
PAGE_LOAD_TIMEOUT=30

# Retry failed applications
RETRY_FAILED=true
MAX_RETRIES=3
