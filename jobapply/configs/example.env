# Runtime paths are resolved from the jobapply application root.
APPLICATIONS_CSV=logs/applications.csv
FILTERS_DIR=configs/filters
# PROFILE_PATH=configs/profile.json

# Browser settings
HEADLESS=false
SLOW_MO=250
MAX_APPLICATIONS=25
# CHROME_USER_DATA_DIR=configs/chrome-profile
# CHROME_PROFILE_DIRECTORY=Default
# CHROME_DEBUGGER_ADDRESS=127.0.0.1:9222

# Platform credentials (leave unset when a reusable profile is already signed in)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
INDEED_EMAIL=
INDEED_PASSWORD=
GLASSDOOR_EMAIL=
GLASSDOOR_PASSWORD=
FOUNDIT_EMAIL=
FOUNDIT_PASSWORD=

# Candidate form data and optional unknown-question helper
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
RESUME_PATH=
GEMINI_API_KEY=

# Audio & Visual Alerts
ENABLE_ALERTS=true
NOTIFICATION_SOUND_PATH=notify/job.mp3

# Optional JSON, normally supplied by the backend.
# JOBAPPLY_BOT_CONFIG={"platform":"linkedin","filters":[],"headless":false,"slowMo":250,"maxApplications":25}
